<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    # Keep the /resources landing page on the bare URL instead of Apache
    # forcing /resources/ because the directory exists for stored files.
    DirectorySlash Off

    RewriteEngine On

    # Redirect www host to apex host.
    RewriteCond %{HTTP_HOST} ^www\.armely\.com$ [NC]
    RewriteRule ^ https://armely.com%{REQUEST_URI} [L,R=301,NE]

    # Route all /admin paths through Laravel EXCEPT static asset folders
    # (css, js, images). Support both deployment styles:
    # - URI starts with /admin/... (docroot points to /public)
    # - URI starts with /public/admin/... (docroot points to project root)
    RewriteCond %{REQUEST_URI} !^/(public/)?admin/(css|js|images)/ [NC]
    RewriteRule ^admin(/.*)?$ index.php [L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # The public/resources directory is used for stored files, but the
    # /resources landing page should still be handled by Laravel.
    RewriteRule ^resources/?$ index.php [L]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Route all /store/* requests to the store bridge.
    # Without this rule, /store/api/v1/products falls through to the
    # main app's catch-all because it is not a physical file or directory.
    RewriteCond %{REQUEST_URI} ^/store(/|$)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ store/index.php [L]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ---------------------------------------------------------------
# Security Headers (Apache level — applies to all responses)
# ---------------------------------------------------------------
<IfModule mod_headers.c>
    # Strict Transport Security — force HTTPS for 1 year
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Clickjacking protection
    Header always set X-Frame-Options "SAMEORIGIN"

    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy — disable unused browser features
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), gyroscope=(), magnetometer=()"

    # Cross-Origin Resource Policy
    Header always set Cross-Origin-Resource-Policy "same-site"
</IfModule>
