APP_NAME="Armely"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=8000
FRONTEND_URL=http://localhost
ASSET_URL=
PUBLIC_STORAGE_URL=http://localhost/storage

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

VITE_APP_BASE_PATH=/
VITE_API_URL=http://localhost/api

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=armely_new_db
DB_USERNAME=root
DB_PASSWORD=
DB_FOREIGN_KEYS=true
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=armely_admin_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
RESOURCE_STORAGE_DISK=resources
RESOURCE_SHARE_BASE_URL=${APP_URL}
RESOURCE_PUBLIC_STORAGE_URL=${APP_URL}/storage/resources
RESOURCE_MAX_FILE_KB=51200
RESOURCE_MAX_THUMBNAIL_KB=8192
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=armely

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
NO_REPLY_EMAIL="noreply@example.com"
REPLY_TO_EMAIL="support@example.com"
MAIL_SUBJECT_PREFIX="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

ADMIN_NAME="Armely Admin"
ADMIN_EMAIL="admin@yourcompany.com"
ADMIN_PASSWORD=

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=resources
FROM_EMAIL="noreply@example.com"

CAPTURE_SITE_KEY=
CAPTURE_SERVER_SIDE_KEY=
GA4_ID=
GOOGLE_ADS_ID=

STORE_URL=http://localhost/store
ADMIN_URL=http://localhost/admin

VITE_APP_NAME="${APP_NAME}"
