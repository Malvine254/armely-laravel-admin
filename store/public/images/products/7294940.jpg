<style>
/* ===================== OUTER SPACING (RESTORED) ===================== */
#custom-columns-template--26521042616599__product_banners_grid_6tnwPB {
  width: 100%;
  padding-top: 80px;
  margin-bottom: 80px;
}

#custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-columns__wrapper {
  display: flex;
  flex-wrap: wrap;
  gap: 24px;
  max-width: 1400px;
  padding: 0 25px;
  margin: 0 auto;
}

/* ===================== COLUMN BASE ===================== */
#custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column {
  position: relative;
  flex: 1 1 calc(33.333% - 24px);
  aspect-ratio: 1/1;
  isolation: isolate;
}

/* Background shape */
#custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column::before {
  content: "";
  position: absolute;
  inset: 0;
  background-color: var(--bg, #f5f5f5);
  clip-path: polygon(0 0,100% 0,100% 66.667%,66.667% 100%,0 100%);
  z-index: 0;
  pointer-events: none;
}

#custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column.has-bg-image::before {
  background-image: var(--bg-img);
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

/* ===================== FULL LINK OVERLAY (RESTORED) ===================== */
#custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__full-link {
  position: absolute;
  inset: 0;
  z-index: 10;
  display: block;
  background: transparent;
  text-indent: -9999px;
  pointer-events: auto;
}

/* ===================== INNER LAYOUT ===================== */
#custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__inner {
  position: absolute;
  inset: 0;
  padding: 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: normal;
  z-index: 1;

  pointer-events: none;
  min-height: 0;
}

/* Colors */
#custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__heading { color: var(--heading-color) !important; }
#custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__text { color: var(--text-color) !important; }
#custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__feature-rich,
#custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__feature-rich * { color: var(--richtext-color) !important; }

/* ===================== LOGO (MAX 40px HIGH) ===================== */
#custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__logo {
  position: absolute;
  top: 16px;
  left: 50%;
  transform: translateX(-50%);
  max-height: 40px;
  width: auto;
  height: auto;
}

/* ===================== HEADING ===================== */
#custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__heading {
  margin-top: 40px;
  margin-bottom: 12px;
  text-align: center;
}

#custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column:not(.has-logo) .custom-column__heading {
  margin-top: 16px;
}

#custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column.has-bg-image:not(.has-logo) .custom-column__heading {
  margin-top: -4px;
}

/* ===================== FEATURE CONSTRAINT (DESKTOP/TABLET) ===================== */
#custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__feature {
  position: static;
  top: auto;
  left: auto;
  transform: none;

  flex: 1 1 auto;
  min-height: 0;

  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

#custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__product {
  display: block;
  max-width: 70%;
  max-height: 100%;
  height: auto;
  object-fit: contain;
}

#custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__feature-rich {
  max-width: 96%;
  text-align: center;
  line-height: 1.45;
}

/* ===================== FOOTER ===================== */
#custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__text {
  align-self: flex-start;
  margin-top: auto;
  padding-bottom: 6px;
  max-width: 60%;
  overflow-wrap: anywhere;
}

/* ===================== ARROW (RESTORED) ===================== */
#custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__arrow-wrap {
  position: absolute;
  bottom: 6px;
  right: 6px;
  width: 48px;
  height: 48px;
  z-index: 2;
  pointer-events: none;
}
#custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__arrow svg { width: 100%; height: 100%; }

/* ===================== ≤1024px ===================== */
@media (max-width: 1024px) {
  /* ✅ body text 10% smaller (instead of 33%) */
  #custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__text {
    font-size: 0.9em;
    padding-bottom: 0;
  }

  /* bring footer closer to outside bottom edge (~18px) */
  #custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__inner {
    padding-bottom: 18px;
  }

  /* slightly reduce feature width on tablet */
  #custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__product {
    max-width: 66%;
    margin-left: auto;
    margin-right: auto;
  }

  /* TRUE CENTERING at ≤1024 */
  #custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__feature {
    justify-self: center;
    margin-left: auto;
    margin-right: auto;
  }
  #custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__product {
    justify-self: center;
  }
  #custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__feature-rich {
    justify-self: center;
    margin-left: auto;
    margin-right: auto;
  }
}

/* ===================== MOBILE ===================== */
@media (max-width: 767px) {
  #custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column { flex: 1 1 100%; }
  #custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-columns__wrapper { padding: 0 15px; gap: 16px; }

  /* 4 rows: logo | heading | feature | footer */
  #custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__inner {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    grid-template-areas: "logo" "heading" "feature" "footer";
    align-items: center;
    justify-items: center;
    padding: 16px;
    height: 100%;
    min-height: 100%;
  }

  /* Assign areas */
  #custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__logo    { grid-area: logo; position: static; transform: none; margin: 4px 0 6px; }
  #custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__heading { grid-area: heading; margin: 6px 0 8px; width: 100%; text-align: center; }

  /* Feature row (MOBILE) — true centering */
  #custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__feature {
    grid-area: feature;
    width: auto;
    max-width: 100%;
    height: 100%;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    justify-self: center;
  }

  #custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__product {
    display: block;
    margin: 0 auto;
    width: 70%;
    max-width: 70%;
    max-height: 100%;
    height: auto;
    object-fit: contain;
    justify-self: center;
  }

  #custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column:not(.has-logo) .custom-column__inner {
    padding-left: 16px;
    padding-right: 16px;
    justify-content: center;
  }

  #custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column:not(.has-logo) .custom-column__product {
    width: 88%;
    max-width: 88%;
    margin-left: auto;
    margin-right: auto;
    justify-self: center;
  }

  #custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__feature-rich {
    grid-area: feature;
    width: 100%;
    max-width: 96%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    justify-self: center;
  }
  #custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__feature-rich p {
    margin-left: 0;
    margin-right: 0;
  }

  /* Footer pinned */
  #custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__text {
    grid-area: footer;
    justify-self: start;
    align-self: end;
    max-width: 70%;
    margin: 0;
    padding: 0 0 6px 0;
  }

  /* Arrow fixed bottom-right */
  #custom-columns-template--26521042616599__product_banners_grid_6tnwPB .custom-column__arrow-wrap {
    position: absolute;
    bottom: 8px;
    right: 8px;
  }
}
</style>


