<style>
  /* =========================
     OUTER
     ========================= */
  .tc-links {
    background: var(--tc-bg);
  }

  .tc-links__outer {
    margin-top: var(--tc-mt);
    margin-bottom: var(--tc-mb);
    padding-top: var(--tc-pt);
    padding-bottom: var(--tc-pb);
  }

  .tc-links__inner {
    max-width: var(--tc-max);
    margin: 0 auto;
    padding-left: var(--tc-px);
    padding-right: var(--tc-px);
  }

  /* =========================
     GRID (desktop default)
     ========================= */
  .tc-links__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 32px;
    align-items: start;
  }

  .tc-links__heading {
    color: var(--tc-heading);
    margin: 0;
    line-height: 1.1;
  }

  /* =========================
     HEADING ARROW (desktop/tablet)
     ========================= */
  .tc-links__heading-arrow {
    margin-top: var(--tc-heading-arrow-mt);
    margin-bottom: var(--tc-heading-arrow-mb);
    margin-left: var(--tc-heading-arrow-ml);
    padding-left: var(--tc-heading-arrow-pl);

    color: var(--tc-heading-arrow-color);
    transform: rotate(var(--tc-heading-arrow-rotate));
    transform-origin: left top;

    max-width: 100%;
    overflow: hidden;
    width: min(100%, var(--tc-heading-arrow-maxw));
  }

  .tc-links__heading-arrow svg {
    width: 100%;
    height: auto;
    fill: currentColor;
    display: block;
  }

  /* =========================
     LINKS LIST (2 columns)
     ========================= */
  .tc-links__list {
    list-style: none;
    margin: 0;
    padding: 0;

    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 22px;
  }

  .tc-links__link {
    display: block;
    width: 100%;
    padding: 10px 0;

    text-decoration: none;
    color: var(--tc-link);
    font-weight: 600;

    border-bottom: 1px solid rgba(0,0,0,0.12);
  }

  /* Arrow sits immediately to the right of the label */
  .tc-links__content {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    max-width: 100%;
  }

  .tc-links__label {
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .tc-links__arrow {
    display: inline-flex;
    width: 18px;
    height: 18px;
    flex: 0 0 18px;

    color: var(--tc-link-arrow-color);

    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .tc-links__arrow svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .tc-links__link:hover {
    color: var(--tc-link-hover);
  }

  .tc-links__link:hover .tc-links__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* =========================
     TABLET (<=1024px)
     - DO NOT STACK
     - Make both columns flexible and prevent overflow
     ========================= */
  @media (max-width: 1024px) {
    .tc-links__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 20px;
    }

    .tc-links__list {
      gap: 12px 16px;
    }

    .tc-links__content {
      gap: 6px;
    }
  }

  /* =========================
     MOBILE (<=640px)
     - STACK
     - remove space between heading arrow and first link
     - mobile arrow sizing uses customizer setting
     ========================= */
  @media (max-width: 640px) {
    .tc-links__grid {
      grid-template-columns: 1fr;
      gap: 0; /* removes the vertical gap between left and right blocks */
    }

    .tc-links__heading-arrow {
      /* responsive/smaller on mobile */
      width: min(100%, var(--tc-heading-arrow-maxw-mobile));
      margin-bottom: 0 !important; /* remove space before first link */
    }

    .tc-links__list {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .tc-links__link {
      padding: 12px 0;
    }
  }
</style>


</div><div id="shopify-section-template--26521042616599__partner_logo_marquee_gWrCQ9" class="shopify-section"><style>
  .partner-logos-marquee .flex-container {
    display: flex;
    justify-content: space-between;
    align-items: center; /* vertical center both columns */
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px 30px 20px;
  }

  .partner-logos-marquee .column {
    padding: 10px;
  }

  /* first column = 1/5 with faded right border at the true edge */
  .partner-logos-marquee .column-one {
    flex: 0 0 20%;
    margin-right: 20px;
    position: relative;
  }
  .partner-logos-marquee .column-one::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    right: -20px; /* sit at the very edge */
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      #ccc 20%,
      #ccc 80%,
      transparent 100%
    );
  }

  /* second column: fill remaining space, no left gutter/padding */
  .partner-logos-marquee .column-two {
    flex: 1;
    margin-left: 0;
    padding-left: 0;
    overflow: hidden;
    position: relative;
  }

  .logo-marquee-track {
    display: flex;
    align-items: center;    /* vertical center logos */
    gap: 20px;              /* spacing between logos */
    width: max-content;     /* fit all items */
    animation: logo-scroll 45s linear infinite;
  }

  .logo-item {
    flex: none;
  }

  .logo-item img {
    max-width: 130px;
    height: auto;
    object-fit: contain;
  }

  @keyframes logo-scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); } /* scroll one full set */
  }

  @media (max-width: 768px) {
    .partner-logos-marquee .flex-container {
      flex-direction: column;
      align-items: center;
    }
    .partner-logos-marquee .column {
      width: 100%;
      margin: 0 0 20px;
      flex: none;
    }
    /* center the heading on mobile */
    .partner-logos-marquee .column-one h2 {
      text-align: center;
      margin: 0 auto;
    }
  }
</style>

