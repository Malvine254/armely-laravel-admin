<style>
  /* === 45° bottom-right cutout (responsive) === */
  .shoppable-image__wrapper { position: relative; }

  .shoppable-image__image,
  .shoppable-image__placeholder-image {
    display: block;
    width: 100%;
    height: auto;
  }

  /*
    We apply clip-path on the IMG/SVG element itself.
    Uses a responsive size:
      --cut45-size-desktop: user setting
      --cut45-mobile-factor: scales down on small screens
      --cut45-min / --cut45-max: clamps the value so it never looks insane
  */
  .shoppable-image__wrapper--cut45 {
    /* Desktop value from settings (px) */
    --cut45-size-desktop: var(--cut45-size-desktop, 64px);

    /* Mobile scaling factor (0.55 = 45% smaller) */
    --cut45-mobile-factor: 0.55;

    /* Clamp guardrails */
    --cut45-min: 12px;
    --cut45-max: 96px;

    /* Default (desktop/tablet): clamp(desktop setting) */
    --cut45-size-effective: clamp(var(--cut45-min), var(--cut45-size-desktop), var(--cut45-max));
  }

  /* On mobile: scale down the desktop setting and clamp */
  @media (max-width: 767px) {
    .shoppable-image__wrapper--cut45 {
      --cut45-size-effective: clamp(
        var(--cut45-min),
        calc(var(--cut45-size-desktop) * var(--cut45-mobile-factor)),
        var(--cut45-max)
      );
    }
  }

  .shoppable-image__wrapper--cut45 .shoppable-image__image,
  .shoppable-image__wrapper--cut45 .shoppable-image__placeholder-image {
    -webkit-clip-path: polygon(
      0 0,
      100% 0,
      100% calc(100% - var(--cut45-size-effective)),
      calc(100% - var(--cut45-size-effective)) 100%,
      0 100%
    );
    clip-path: polygon(
      0 0,
      100% 0,
      100% calc(100% - var(--cut45-size-effective)),
      calc(100% - var(--cut45-size-effective)) 100%,
      0 100%
    );
  }

  /* Avoid rounding artifacts */
  .shoppable-image__wrapper--cut45 .shoppable-image__image,
  .shoppable-image__wrapper--cut45 .shoppable-image__placeholder-image {
    border-radius: 0 !important;
    overflow: hidden;
  }

  /* Hotspots must sit above the image */
  .shoppable-image__hotspot { position: absolute; z-index: 5; }
</style>

<script type="application/pxs-animation-mapping+json">
  {
    "blocks": [".shoppable-image"],
    "elements": [
      ".shoppable-image__hotspot",
      ".shoppable-image__text-box-title",
      ".shoppable-image__text-box-subheading",
      ".shoppable-image__text-box-button"
    ]
  }
</script>

