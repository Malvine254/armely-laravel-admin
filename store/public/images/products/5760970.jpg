async function tefTrackLinkedInConversion(
conversionId,conversionCurrency = null,conversionValue = null,conversionType = null
) {const maxRetries = 5;const retryDelay = 500;if (!conversionId) {console.warn("LinkedIn Insight Tag: conversionId is required.");return;}for (let attempt = 1; attempt <= maxRetries; attempt++) {if (typeof window.lintrk === "function") {try {// Build tracking object with only non-null values
const trackingData = {conversion_id: `${conversionId}`
};if (conversionCurrency !== null) {trackingData.conversion_currency = `${conversionCurrency}`;}if (conversionValue !== null) {trackingData.conversion_value = `${conversionValue}`;}if (conversionType !== null) {trackingData.conversion_type = `${conversionType}`;}window.lintrk("track", trackingData);console.debug(`LinkedIn conversion ${conversionId} tracked successfully`);return;} catch (error) {console.error(`Error executing LinkedIn tracking for ${conversionId}:`, error);return;}}if (attempt < maxRetries) {console.debug(
`LinkedIn tracking not yet available, retrying... (${attempt}/${maxRetries})`
);await new Promise((resolve) => setTimeout(resolve, retryDelay));}}console.warn(
`LinkedIn Insight Tag: (lintrk) not available after ${maxRetries} retries. Tracking skipped.`
);}</script>	<script type="text/javascript" id="linkedin-add-to-cart-tracking">// Wait for both DOM and jQuery to be ready before setting up the event listener.
