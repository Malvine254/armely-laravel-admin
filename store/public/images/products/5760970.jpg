p"><div class="off-canvas-menu-group-item"><a class="off-canvas-menu-group-item-link" href="https://www.retailmarket.net/account/newsletter/" title="Get up-to 60% off when you join">Join the Newsletter</a></div><div class="off-canvas-menu-group-item"><a class="off-canvas-menu-group-item-link" href="https://www.retailmarket.net/account/rewards/" title="Earn and redeem your TRM-Rewards">Earn with Rewards</a></div></div></div></div></div><div id="searchOverlay" class="search-overlay hidden"><div class="search-container"><div class="search-form-container"><div class="search-form-header"><span class="search-header-text">🔍 The Retail Market</span><button id="closeSearch" class="search-form-button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24"	class="search-form-button__svg"><path	d="M13.414 12L19.07 6.343L17.656 4.929L12 10.586L6.343 4.929L4.929 6.343L10.586 12L4.929 17.656L6.343 19.07L12 13.414L17.656 19.07L19.07 17.656L13.414 12Z"></path></svg></button></div><form action="/" method="GET" class="search-form"><span class="search-form-input__help-text">Start typing for suggestions or press enter on your keyboard to search</span><input type="search" name="s" placeholder="Enter keyword or SKU" class="search-form-input"></form></div></div></div><script type="text/javascript" id="trm-header-js">
let openButton = document.querySelector('.nav-menu-sm-button');let closeButton = document.querySelector('.off-canvas-menu-button');let dialog = document.querySelector('.off-canvas-dialog');let menu = document.querySelector('.off-canvas-menu');let menuWrapper = document.querySelector('.off-canvas-wrapper');let body = document.body;openButton.addEventListener('click', () => {// Show the dialog
dialog.classList.remove('ocm-dialog-hidden');// Start a timeout to allow the dialog to be displayed before starting the transition
setTimeout(() => {// Show the dialog
dialog.classList.remove('ocm-dialog-closed');dialog.classList.add('ocm-dialog-open');// Slide in the menu
menuWrapper.classList.remove('ocm-menu-negative');menuWrapper.classList.add('ocm-menu-positive');}, 30); // 20 ms should be enough, but you can increase it if necessary
// Disable scroll on body
body.classList.add('disable-scroll');});closeButton.addEventListener('click', () => {// Hide the dialog
dialog.classList.remove('ocm-dialog-open');dialog.classList.add('ocm-dialog-closed');// After the transition ends, add the hidden class to completely hide it
dialog.addEventListener(
'transitionend',() => {dialog.classList.add('ocm-dialog-hidden');},{ once: true }); // Remove the event listener after it has been called once
// Slide out the menu
menuWrapper.classList.remove('ocm-menu-positive');menuWrapper.classList.add('ocm-menu-negative');// Enable scroll on body
body.classList.remove('disable-scroll');});// This will close the menu when clicking outside of the menu itself
dialog.addEventListener('click', () => {closeButton.click();});// This will stop propagation of click events from inside the menu,
// preventing the above event listener from closing the menu
menuWrapper.addEventListener('click', (event) => {event.stopPropagation();});
function closeSearchOverlay(event) {const searchOverlay = document.getElementById('searchOverlay');const searchContainer = document.querySelector('.search-form-container');if (
event.target === searchOverlay ||
!searchContainer.contains(event.target)
) {searchOverlay.classList.add('hidden');// Enable scroll on body
body.classList.remove('disable-scroll');}}document.addEventListener('DOMContentLoaded', () => {const searchButton = document.getElementById('nav-search');const mobileSearchButton = document.getElementById('mobile-nav-search');const closeSearch = document.getElementById('closeSearch');const searchOverlay = document.getElementById('searchOverlay');let body = document.body;searchButton.addEventListener('click', () => {searchOverlay.classList.remove('hidden');// Disable scroll on body
body.classList.add('disable-scroll');});mobileSearchButton.addEventListener('click', () => {searchOverlay.classList.remove('hidden');// Disable scroll on body
body.classList.add('disable-scroll');});closeSearch.addEventListener('click', () => {searchOverlay.classList.add('hidden');// Enable scroll on body
body.classList.remove('disable-scroll');});searchOverlay.addEventListener('click', closeSearchOverlay);});</script></div><section id="primary"><main id="main"><div class="front-hero"><div class="front-hero-container"><div class="front-hero-wrapper"><div class="front-hero-content"><span class="front-hero-content-heading">Discover Infinite Possibilities!</span><p class="front-hero-content-message">Step into a world where quality meets convenience. From handpicked homeware to must-have office products - we've got it all under one digital roof. Begin your seamless shopping journey with us today.</p></div><div><div class="front-hero-media"><div aria-hidden="true" class="pointer-events-none lg:absolute lg:inset-y-0 lg:mx-auto lg:w-full lg:max-w-7xl"><div class="front-hero-media-container"><div class="front-hero-media-wrapper"><div class="front-hero-media-column"><div	class="front-hero-media-first"><img data-perfmatters-preload width="640" height="960" src="//trm-assets.exceptionalcdn.com/static/dam/content/themes/retailmarketv1/media/fp-hero-1.jpg"	alt="The Retail Market Hero Image" class="front-hero-media-image"></div><div class="front-hero-media-rest"><img data-perfmatters-preload width="640" height="1138" src="//trm-assets.exceptionalcdn.com/static/dam/content/themes/retailmarketv1/media/fp-hero-2.jpg"	alt="The Retail Market Hero Image" class="front-hero-media-image"></div></div><div class="front-hero-media-column"><div class="front-hero-media-rest"><img data-perfmatters-preload width="640" height="960" src="//trm-assets.exceptionalcdn.com/static/dam/content/themes/retailmarketv1/media/fp-hero-3.jpg"	alt="The Retail Market Hero Image" class="front-hero-media-image"></div><div class="front-hero-media-rest"><img data-perfmatters-preload width="640" height="959" src="//trm-assets.exceptionalcdn.com/static/dam/content/themes/retailmarketv1/media/fp-hero-4.jpg"	alt="The Retail Market Hero Image" class="front-hero-media-image"></div><div class="front-hero-media-rest"><img wi