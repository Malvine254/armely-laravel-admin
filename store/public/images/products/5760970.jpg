const trackingData = {};
Object.keys(eventData).forEach(key => {if (eventData[key] !== null && eventData[key] !== undefined) {trackingData[key] = eventData[key];}});
window.twq('event', eventId, trackingData);console.debug(`Twitter event ${eventId} tracked successfully`);return;} catch (error) {console.error(`Error executing Twitter tracking for ${eventId}:`, error);return;}}if (attempt < maxRetries) {console.debug(
