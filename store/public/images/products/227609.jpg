    <script type="text/javascript">

        //Le doSearch doit etre ici sinon ne fonctionne pas dans IE, FireFox ou Edge
        function doSearch() {
            if ($('#search_query_top').val().trim()) {
                $("#divLoad").removeClass('d-none');
                var sHref = $("#searchBtn").data('request-url');
                //Remove category number
                sHref = sHref.substring(0, sHref.indexOf("/cat/")) + "/cat/";
                var searchText = $("#search_query_top").val();
                if (searchText == null || searchText == "")
                    searchText = getParameterByName('s');
                var hasFirst = (searchText != null && searchText != "");

                if (hasFirst)
                    sHref += "?s=" + searchText;

                location.assign(window.location.origin + sHref);
            }
            return false;
        }



        function getParameterByName(name, url) {
            if (!url) url = window.location.href;
            name = name.replace(/[\[\]]/g, "\\$&");
            var regex = new RegExp("[?&]" + name + "(=([^&#]*)|&|#|$)"),
                results = regex.exec(url);
            if (!results) return null;
            if (!results[2]) return '';
            return decodeURIComponent(results[2].replace(/\+/g, " "));
        }

        function getSearch() {
            if (location.href !== '') {
                var data = location.href.replace('?', '&');

                var pairs = data.split('&');
                var tmp = []
                var search = {};

                for (i = 0; i < pairs.length; i++) {
                    tmp = pairs[i].split('=')
                    search[tmp[0]] = tmp[1];
                }
                return search;
            }
            else {
                return {};
            }
        }

        function acceptCookies() {
            $("#cookieDiag").css('opacity', 0);
            setTimeout(function () {
                $("#cookieDiag").addClass('d-none');
            }, 1000);

            setCookie("AllowCookies", "true", 30 * 24); // Set the cookie to expire in 30 days
        }

        function disableCookies() {
            $("#cookieDiag").css('opacity', 0);
            setTimeout(function () {
                $("#cookieDiag").addClass('d-none');
            }, 1000);

            $(".requireCookies").remove();
            $(".requireCookies").html('');

            clearAllCookies();

            // Set the cookie to expire in 15 days
            setCookie("AllowCookies", "false", 15 * 24);
        }

        function clearAllCookies() {
            var cookies = document.cookie.split(';');
            for (var i = 0; i < cookies.length; i++) {
                var cookie = cookies[i];
                var eqPos = cookie.indexOf("=");
                var name = eqPos > -1 ? cookie.substr(0, eqPos) : cookie;
                document.cookie = name + "=;expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
            }
        }
    </script>

    <script type="text/javascript" src="/Scripts/profil.js"></script>

    <script type='text/javascript'>
			function Increase(element) {
				$.ajax({
					url: '/fr/shoppingcart/increaseitem/',
					type: 'POST',
					contentType: 'application/json;',
					data: JSON.stringify({ sId: element }),
					success: function (response) {
						if (response != null && response == "success") {
							location.reload();
						}
					}
				});
			}

			function Decrease(element) {
				$.ajax({
					url: '/fr/shoppingcart/decreaseitem/',
					type: 'POST',
					contentType: 'application/json;',
					data: JSON.stringify({ sId: element }),
					success: function (response) {
						if (response != null && response == "success") {
							location.reload();
						}
					}
				});
			}

			//Cancel l'event du enter dans le detail de produit
			$(".qteInputDetail").bind("keydown", function (event) {
				if (event.keyCode == 13) {
					event.preventDefault();
				}
			});

			$(document).ready(function () {
				$('input[type=datetime]').datepicker({
					dateFormat: "dd/M/yy",
					changeMonth: true,
					changeYear: true,
					yearRange: "-60:+0"
                });


			});

			//Gestion d'ajout dans le shopping cart depuis le detail de produit
			$(".qteInputDetail").bind("keyup", function (event) {
				if (event.keyCode == 13) {
					//Validation du multiplier
					if ($('#MultipleAchat').length) {
						var multiplier = $('#MultipleAchat').text();

						if (this.value % multiplier != 0) {
                            $("#dialogError").removeClass("d-none");
							$("#dialogError").dialog();
						}
						else {
                            $("#dialogError").addClass("d-none");
							$("#btnAddCart").click();
							window.location = document.referrer;
						}
					}
					else {
						if (this.value > 0) {
							$("#btnAddCart").click();
							window.location = document.referrer;
						}
					}
				}
				else {
					if (/\D/g.test(this.value)) {
						this.value = this.value.replace(/\D/g, '');
					}
				}
			});
    </script>

    <!--Row Clickable-->
    <script>
        //Pour le transporteur dans 'Checkout'
        $("#transportTable").delegate('tr', 'click', function () {
            if ($(this).attr("class") !== "headerRow") {
                var input = $(this).closest("tr").find("input.serviceName");
                input.change();
            }
        });

        //Pour la selection de l'onglet dans 'Mon Profil'
        $("#profile").delegate('tr', 'click', function () {
            var anchor = $(this).closest("tr").find("a");
            window.location = $(anchor).attr('href');
        });
    </script>

    <!-- #Validation d'account -->
    <script>
            var ValidationMode = false;

			$('#loginForm').submit(function () {
				var erreurs = false;
				var imagePath = '/Images/invalide.png';
				resetErrors();

				if ($.trim($('#modelUserName').val()) === '') {
					$('#registerUserName').prepend($('<img>', { id: 'theImg', src: imagePath}));
					$('#MessageUserName').text("Le champ 'Courriel' ne peut être vide");
					erreurs = true;
				}

				if ($.trim($('#modelPassword').val()) === '') {
					$('#registerPassword').prepend($('<img>', { id: 'theImg', src: imagePath }));
					$('#MessagePassword').text("Le champ 'Mot de passe' ne peut être vide ");
					erreurs = true;
				}

				if (erreurs === true) {
					return false;
				}
			});

            function RedirectToHome() {
                location.href = window.location.origin;
            }

            function LinkToSite(url) {
                if (url && url !== "") {
                    if (!url.toUpperCase().startsWith('HTTP'))
                        url = "http://" + url;
                    window.open(url, '_blank');
                }
            }

            $('#resetForm').submit(function () {
                var erreurs = false;
				var imagePath = '/Images/invalide.png';
				resetErrors();

				if ($.trim($('#modelPassword').val()) === '') {
					$('#registerPassword').prepend($('<img>', { id: 'theImg', src: imagePath }));
					$('#MessagePassword').text("Le champ 'Mot de passe' ne peut être vide ou doit être conforme aux critères");
					erreurs = true;
				}

                if ($.trim($('#modelPasswordConfirm').val()) === '' || $.trim($('#modelPasswordConfirm').val()) !== $.trim($('#modelPassword').val())) {
					$('#registerPasswordConfirm').prepend($('<img>', { id: 'theImg', src: imagePath }));
					$('#MessagePasswordConfirm').text("Le champ 'Confirmation de mot de passe' ne peut être vide ou ne correspond pas au champ 'Mot de passe'");
					erreurs = true;
                }

                if (erreurs === true) {
                    return false;
                }
            });

			function resetErrors() {
                $('#message').addClass('d-none');

				$('#registerUserName').empty();
				$('#registerPassword').empty();
				$('#registerPasswordConfirm').empty();
				$('#registerNom').empty();
				$('#registerAdresse').empty();
				$('#registerVille').empty();
				$('#registerCodePostal').empty();

				$('#MessageUserName').text("");
				$('#MessagePassword').text("");
				$('#MessagePasswordConfirm').text("");
				$('#MessageNom').text("");
				$('#MessageAdresse').text("");
				$('#MessageVille').text("");
                $('#MessageCodePostal').text("");
            }

			$('#modelPassword').blur(function () {
				if ("/fr/ErrorHandler/NotFound?aspxerrorpath=/Media/400/710-00xxbl.jpg" !== "/en/account/login/" && "/fr/ErrorHandler/NotFound?aspxerrorpath=/Media/400/710-00xxbl.jpg" !== "/fr/account/login/") {
					var password = $('#modelPassword').val();
					var imagePath = '/Images/invalide.png';
					$.ajax({
						url: '/fr/account/checkpassword/',
						type: 'POST',
						contentType: 'application/json;',
						data: JSON.stringify({ sPassword: password }),
						success: function (response) {
							$('#registerPassword').empty();
							$('#MessagePassword').text("");

                            if (response != null && response == "failed") {
                                $('#registerPassword').prepend($('<img>', { id: 'theImg', src: imagePath }));
                                $('#MessagePassword').text("Le champ 'Mot de passe' ne peut être vide ou doit être conforme aux critères");
                                //if (ValidationMode == false) {
                                //    $('#modelPassword').focus();
                                //}
                            }
						}
					});
				}
         });

         $('#modelUserName').blur(function() {
				if ("/fr/ErrorHandler/NotFound?aspxerrorpath=/Media/400/710-00xxbl.jpg" !== "/en/account/login/" && "/fr/ErrorHandler/NotFound?aspxerrorpath=/Media/400/710-00xxbl.jpg" !== "/fr/account/login/"
				&& "/fr/ErrorHandler/NotFound?aspxerrorpath=/Media/400/710-00xxbl.jpg" !== "/fr/account/register/") {
					const username = $('#modelUserName').val();
					const imagePath = '/Images/invalide.png';
					validateRegisterName(username, "Le champ 'Courriel' est vide, déjà utilisé ou invalide");
				}
			});

			$('#modelCodePostal').keyup(function () {
				this.value = this.value.toUpperCase();
            });

        function ConfirmPolitiques() {
            var bEnable = $("#chkConfirmPolitiqueInfolettre").is(':checked');

            if (!bEnable) {
                $('#btnSubmitInfolettre').attr('disabled', 'true');
            }
            else {
                $('#btnSubmitInfolettre').removeAttr('disabled');
            }

            return bEnable;
        }

        function OpenPolitiquesDialog() {
            InitPolitiquesDialog();
            $("#divPolitiques").removeClass("d-none");
            $('#diagPolitiques').dialog("open");
        }

        function InitPolitiquesDialog() {
            var win = $(window);

            $("#diagPolitiques").dialog({
                autoOpen: false,
                modal: true,
                width: win.width() * 0.9,
                resizable: false,
                draggable: false,
                position: ["center", 20],
                show: "blind",
                hide: "blind",
                title: "",
                create: function (event) {
                    $(event.target).parent().css({
                        'position': 'fixed',
                        'left': win.width() * 0.05,
                        'top': win.height() * 0.05,
                        'max-height': win.height() * 0.9,
                        'overflow-y': 'auto'
                    });

                },
                open: function (event) {
                    $('body').addClass('stop-scrolling');
                },
                beforeClose: function () {
                    $('body').removeClass('stop-scrolling');
                },
                buttons:
                    [
                        {
                            text: "Ok",
                            tabindex: "-1",
                            click: function () {
                                $(this).dialog("close");
                            }
                        }
                    ],
                close: function () {
                    // Close code here (incidentally, same as Cancel code)
                }
            });
        }
    </script>

    <script>
        function slideTo(li) {
            $("#DemoCarousel").carousel(parseInt($(li).attr('data-bind')));
        }
    </script>
    
</body>

</html>
