    <script>
        let modeProd = 'True'.toLowerCase() == 'true';

        $(document).ready(function () {
            setAuthCookie();
            loadCulture();
        });

        function getCookie(cookieName) {
            var name = cookieName + "=";
            var decodedCookie = decodeURIComponent(document.cookie);
            var cookieArray = decodedCookie.split(';');
            for (var i = 0; i < cookieArray.length; i++) {
                var cookie = cookieArray[i].trim();
                if (cookie.indexOf(name) === 0) {
                    return cookie.substring(name.length, cookie.length);
                }
            }
            return null;
        }

        // Function to create a cookie
        function setCookie(cookieName, value, hours) {
            var expires = "";
            if (hours) {
                var date = new Date();
                date.setTime(date.getTime() + (hours * 60 * 60 * 1000));
                expires = "; expires=" + date.toUTCString();
            }
            var newCookie = cookieName + "=" + value + expires + "; path=/";
            document.cookie = newCookie;
        }

        function setAuthCookie() {
            // Check if the AllowCookies cookie exists
            allowCookies = getCookie("AllowCookies");

            if (allowCookies === null) {
                $("#cookieDiag").removeClass('d-none');
            }
        }


        function loadCulture() {
        $.ajax({
			url: '/fr/base/loadculture/',
			type: 'GET',
            contentType: 'application/json;',
            data: { culture: getLangue() },
            success: function () {

            }
        });
        }

        function getLangue() {
            var lang = window.location.href.replace(window.location.origin, "");
            lang = lang ?? "";
            if (lang.startsWith("/en") || lang.startsWith("en"))
                return "en";
            else if (lang.startsWith("/fr") || lang.startsWith("fr"))
                return "fr";
            else
                return "";
        }
    </script>
</head>

