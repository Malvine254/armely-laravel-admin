    <script type="text/javascript">

        $(document).ready(function () {
            $("#DemoCarousel").carousel();

            //Carousel Controls
            $(".left").click(function () {
                $("#DemoCarousel").carousel('prev');
            });
            $(".right").click(function () {
                $("#DemoCarousel").carousel('next');
            });

            $(".btnCookieAccept").click(function () {
                $(".btnCookieAccept").blur();
                acceptCookies();
                //setGoogleAndFacebook();
            });

            $(".btnCookieCancel").click(function () {
                //setCookie("AllowCookies", "false", 30 * 24); // Set the cookie to expire in 30 days
                $(".btnCookieCancel").blur();
                disableCookies();
            });

            loadCart();

            //Mobile menu
            $('.menu-button').on('click', function (e) {
                $('.mobile-menu').toggleClass('menu-open');
                $('.menu-button-wrapper').toggleClass('menu-button-active')
                $('body').toggleClass('noscroll')
            })

            //Product navigation
            $('.product-navigation-menu-header').on('click', function (e) {
                $(this).parent('.product-navigation-menu').toggleClass('product-menu-header__open');
            })

            //Payment methods
            $('.payment-method-picker input:radio').on('change', function (e) {
                $('.payment-method-picker').removeClass('payment-method-picker__selected')
                var realTarget = $(e.target).closest('.payment-method-picker')
                realTarget.addClass('payment-method-picker__selected')
                $('.payment-method-wrapper').removeClass('payment-method-wrapper__active')
                var method = $(e.target).val()
                $('[data-payment-method="' + method + '"]').addClass('payment-method-wrapper__active')
            })

            //Quantity input
            $('.product-quantity-button').on('click', function (e) {
                var button = $(e.target)
                var quantityInput = button.siblings('input')
                var currentValue = Number(quantityInput.val())
                if (button.hasClass('product-quantity-button__decrease') && currentValue > 0) {
                    quantityInput.val(currentValue - 1)
                } else if (button.hasClass('product-quantity-button__increase')) {
                    quantityInput.val(currentValue + 1)
                }
            })

            $(".fake-radio-field input").on('change', function (e) {
                var target = $(e.target)
                target.closest('.fake-radio-field-group').find('.fake-radio-field').removeClass('fake-radio-field__checked')
                target.parent().addClass("fake-radio-field__checked");
            })

            $(".fake-checkbox-field input").on('change', function (e) {
                var target = $(e.target)
                target.parent().toggleClass("fake-checkbox-field__checked");
            })

            /*ajout 2021*/
            $('.onglet_principal h2').on('click', function (e) {
                var parent = $(this).parent();
                if (parent.hasClass("onglet_interne")) {
                    parent.parent().parent().addClass("actif");
                    parent.parent().parent().addClass("temp_actif");
                }
                if (parent.hasClass("actif")) {
                    parent.removeClass("actif");
                } else {
                    parent.addClass("actif");
                    parent.addClass("temp_actif");
                }
                $('.onglet_principal:not(.temp_actif), .onglet_interne:not(.temp_actif)').removeClass('actif');
                $('.onglet_principal, .onglet_interne').removeClass('temp_actif');
            })
        });
    </script>

    <script>
        function closeMoblieMenu() {
            $('.mobile-menu').toggleClass('menu-open');
            $('.menu-button-wrapper').toggleClass('menu-button-active')
            $('body').toggleClass('noscroll')
        }

        function loadCart() {
            var cartGuid = GetCartGuid();

            $.ajax({
                url: '/fr/Base/GetCartGuid',
                type: 'GET',
                data: { currentGuid: cartGuid, canCreateNew: false },
                contentType: 'application/json;',
                success: function (data) {
                    cartGuid = data;
                    SetCartGuid(cartGuid);

                    GetCountItems(cartGuid);
                }
            });
        }

        function GetCountItems(cartGuid) {
            $.ajax({
				url: '/fr/home/getcountitems/',
				type: 'POST',
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify({ "cartGuid": cartGuid }),
                success: function (response) {
                    if (response != null && response != "failed") {
                        //Set the count of items
                        $(".panierCount").removeClass("d-none");
                        $(".panierCount").html(response);
                    }
                    else {
                        $(".panierCount").addClass("d-none");
					}
				}
			});
        }

            function ShowInfolettreErrorDialog() {
                var win = $(window);
                var width = 460;
                var height = win.height() * 0.9;

                if (win.width < 480) {
                    width = 440;
                }
                if (win.width <= 360) {
                    width = 300;
                }

                $("#diagInfolettreError").dialog({
                    modal: true,
                    width: width,
                    resizable: false,
                    draggable: false,
                    position: ["center", 20],
                    show: "blind",
                    hide: "blind",
                    title: "",
                    create: function (event) {
                        $(event.target).parent().css({
                            'position': 'fixed',
                            'left': (win.width() - width) / 2,
                            'top': (win.height() - width) / 2,
                            'overflow-y': 'auto',
                            'max-height': height
                        });
                    },
                    open: function (event) {
                        $('body').addClass('stop-scrolling');
                    },
                    beforeClose: function () {
                        $('body').removeClass('stop-scrolling');
                    },
                    buttons:
                    [
                        {
                            text: "Ok",
                            tabindex: "-1",
                            click: function () {
                                $(this).dialog("close");
                            }
                        }
                    ],
                    close: function () {
                        // Close code here (incidentally, same as Cancel code)
                    }
                });
                $("#diagInfolettreError").removeClass("d-none", 300);
                $("#diagInfolettreError").show();
            }

            function ShowInfolettreSuccessDialog() {
                var win = $(window);
                var width = 460;
                var height = win.height() * 0.9;

                if (win.width < 480) {
                    width = 440;
                }
                if (win.width <= 360) {
                    width = 300;
                }

                $("#diagInfolettreSuccess").dialog({
                    modal: true,
                    width: width,
                    resizable: false,
                    draggable: false,
                    position: ["center", 20],
                    show: "blind",
                    hide: "blind",
                    title: "",
                    create: function (event) {
                        $(event.target).parent().css({
                            'position': 'fixed',
                            'left': (win.width() - width) / 2,
                            'top': (win.height() - width) / 2,
                            'overflow-y': 'auto',
                            'max-height': height
                        });
                    },
                    open: function (event) {
                        $('body').addClass('stop-scrolling');
                        setTimeout(function () {
                            $("#diagInfolettreSuccess").dialog('close');
                        }, 3000);
                    },
                    beforeClose: function () {
                        $('body').removeClass('stop-scrolling');
                    },
                    close: function () {
                        // Close code here (incidentally, same as Cancel code)
                    }
                });
                $("#diagInfolettreSuccess").removeClass("d-none", 300);
                $("#diagInfolettreSuccess").show();
            }

            function AddToInfolettre() {
                var email = $("#emailInfolettre").val();
                var testEmail = /^[A-Z0-9._%+-]+@([A-Z0-9-]+\.)+[A-Z]{2,4}$/i;
                if (testEmail.test(email)) {
                    $('#btnSubmitInfolettre').prop('disabled', true);

                    //Mettre le courriel dans la table avec un call ajax
                    $.ajax({
					    url: '/fr/account/addinfolettre/',
                        type: 'POST',
                        data: JSON.stringify({ email: email }),
					    contentType: 'application/json;',
                        success: function (response) {
                            if (response != null && response != "failed") {
                                ShowInfolettreSuccessDialog();
                                $("#infolettre-input").val("");
                                $("#dialogInfolettreConfirm").addClass("d-none");
                                $("#dialogInfolettreConfirm").dialog("close");
                                $('#btnSubmitInfolettre').prop('disabled', false);
                            }
                            else {
                                ShowInfolettreErrorDialog();
                                $('#btnSubmitInfolettre').prop('disabled', false);
                            }
					    }
                    });
                }
                else {
                    ShowInfolettreErrorDialog();
                }
            };

        function ShowDialogInfolettre() {
            var email = $("#infolettre-input").val();

            var win = $(window);

            var height = win.height() * 0.9;
            var width = 460;

            if (win.width < 480) {
                width = 440;
            }
            if (win.width <= 360) {
                width = 300;
            }

            $("#dialogInfolettreConfirm").dialog({
                modal: true,
                width: width,
                resizable: false,
                draggable: false,
                position: ["center", 20],
                show: "blind",
                hide: "blind",
                title: "",
                create: function (event) {
                    $(event.target).parent().css({
                        'position': 'fixed',
                        'left': (win.width() - width) / 2,
                        'top': (win.height() - width) / 2,
                        'overflow-y': 'auto',
                        'max-height': height
                    });
                },
                open: function (event) {
                    $('body').addClass('stop-scrolling');
                    //Unhcheck confirm checkbox
                    $('#chkConfirmPolitiqueInfolettre').prop('checked', false); // Unchecks it
                    if ($('#chkConfirmPolitiqueInfolettre').parent())
                        $('#chkConfirmPolitiqueInfolettre').parent().removeClass('checked'); // Remove class checked from parent span
                },
                close: function (event, ui) {
                    $('body').removeClass('stop-scrolling');
                },
            });

            $("#emailInfolettre").val(email);
            $("#dialogInfolettreConfirm").removeClass("d-none", 300);
            $("#dialogInfolettreConfirm").show();
            ConfirmPolitiques();
        }

		function ShowDetail(a) {
			var Id = $(a).attr("data-id");
			var language = "";
			if (window.location.href.indexOf("/fr/") > 0) {
				language = "fr";
			}
			else {
				language = "en";
			}
			var path = window.location.origin + '/' + language + '/product/' + Id
			window.location.assign(path);
		};
