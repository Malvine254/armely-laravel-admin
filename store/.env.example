APP_NAME="Armely Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
FRONTEND_URL=http://127.0.0.1:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
# APP_PREVIOUS_KEYS=

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# LOG_DAILY_DAYS=14

# Database
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=armely_store
# DB_USERNAME=root
# DB_PASSWORD=
# DB_SOCKET=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci
# DB_URL=

# Sessions / Cache / Queue
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=armely

MEMCACHED_HOST=127.0.0.1
# MEMCACHED_PORT=11211

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_PREFIX=
# REDIS_DB=0
# REDIS_CACHE_DB=1

# Mail
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@armely.com"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_EHLO_DOMAIN=

# AWS / Files
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_URL=
# AWS_ENDPOINT=

# Frontend
VITE_APP_NAME="${APP_NAME}"

# Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Seed admin account (DatabaseSeeder)
ADMIN_NAME="Armely Admin"
ADMIN_EMAIL="admin@armely.com"
ADMIN_PASSWORD=

# Azure Graph mail service
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
FROM_EMAIL="noreply@armely.com"

# TD SYNNEX StreamOne Ion API
TDSYNNEX_CLIENT_ID=
TDSYNNEX_CLIENT_SECRET=
TDSYNNEX_TOKEN_URL=https://sso.us.tdsynnex.com/oauth2/v1/token
TDSYNNEX_BASE_URL=https://api-uat.us.tdsynnex.com

# TD SYNNEX behavior / tuning
TDSYNNEX_CACHE_ENABLED=true
TDSYNNEX_CACHE_PRODUCTS_TTL=3600
TDSYNNEX_CACHE_VENDORS_TTL=86400
TDSYNNEX_CACHE_PRICING_TTL=1800
TDSYNNEX_CACHE_TOKEN_TTL=6600
TDSYNNEX_TIMEOUT=30
TDSYNNEX_RETRY_MAX_ATTEMPTS=3
TDSYNNEX_RETRY_DELAY=1000
TDSYNNEX_SYNC_INTERVAL=30
TDSYNNEX_SYNC_LOOKBACK_DAYS=90
TDSYNNEX_ENABLE_CACHING=true
TDSYNNEX_ENABLE_WEBHOOKS=false
TDSYNNEX_ENABLE_AUTO_SYNC=true
TDSYNNEX_LOGGING_ENABLED=true
TDSYNNEX_LOGGING_CHANNEL=stack
TDSYNNEX_LOG_REQUESTS=true
TDSYNNEX_LOG_RESPONSES=false
TDSYNNEX_XML_USE_TEST=true
TDSYNNEX_ALLOW_SUBMIT_PO=false
