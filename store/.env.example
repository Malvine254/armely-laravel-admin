APP_NAME="Armely Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
FRONTEND_URL=http://127.0.0.1:8001
ASSET_URL=
APP_TIMEZONE=UTC
SUPPORT_EMAIL="unfo@armely.com"
APP_CURRENCY=USD
APP_CURRENCY_RATE=1
APP_TAX_RATE_PERCENT=0
APP_PROFIT_RATE_PERCENT=15
APP_DEFAULT_SHIPPING_AMOUNT=0
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_COMPANY_ID=
QUICKBOOKS_PAYMENT_URL_TEMPLATE=
QUICKBOOKS_BULK_PAYMENT_URL_TEMPLATE=

# Production subpath deployment:
# APP_URL=https://armely.com
# FRONTEND_URL=https://armely.com/store
# ASSET_URL=https://armely.com/store
# VITE_APP_BASE_PATH=/store/
# VITE_API_URL=/store/api/v1
# VITE_BUILD_DIRECTORY=build

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
# APP_PREVIOUS_KEYS=

# Quote/order lifecycle defaults
QUOTE_EXPIRY_DAYS=30
ORDER_PAYMENT_EXPIRY_HOURS=72

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# LOG_DAILY_DAYS=14

# Database (XAMPP / phpMyAdmin)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=armely_store
DB_USERNAME=root
DB_PASSWORD=
DB_CONNECT_TIMEOUT=3
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# DB_URL=

# Sessions / Cache / Queue
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=3700

CACHE_STORE=file
CACHE_PREFIX=armely

MEMCACHED_HOST=127.0.0.1
# MEMCACHED_PORT=11211

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_PREFIX=
# REDIS_DB=0
# REDIS_CACHE_DB=1

# Mail
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@armely.com"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_EHLO_DOMAIN=
ADMIN_NOTIFY_NEW_ORDERS=true
ADMIN_NOTIFY_NEW_QUOTES=true
ADMIN_NOTIFY_LOW_STOCK=false

# AWS / Files
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_URL=
# AWS_ENDPOINT=

# Frontend
VITE_APP_BASE_PATH=/
VITE_API_URL=/api/v1
VITE_BUILD_DIRECTORY=build
VITE_APP_NAME="${APP_NAME}"

# Analytics / Ads
GA4_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_CONTACT_FORM_CONVERSION_LABEL=contact_form_submit

# Store-specific overrides (recommended when store and main site share a domain)
STORE_GA4_ID=
STORE_GOOGLE_ADS_ID=
STORE_GOOGLE_ADS_CONTACT_FORM_CONVERSION_LABEL=contact_form_submit

# Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Seed admin account (DatabaseSeeder)
ADMIN_NAME="Armely Admin"
ADMIN_EMAIL="admin@yourcompany.com"
ADMIN_PASSWORD=

# Azure Graph mail service
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
FROM_EMAIL="noreply@armely.com"
NO_REPLY_EMAIL="noreply@armely.com"
REPLY_TO_EMAIL="unfo@armely.com"

# Azure OpenAI assistant
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# TD SYNNEX XML / ECExpress API
TDSYNNEX_ENVIRONMENT=sandbox

# TD SYNNEX behavior / tuning
TDSYNNEX_CACHE_ENABLED=true
TDSYNNEX_CACHE_PRODUCTS_TTL=3600
TDSYNNEX_TIMEOUT=30
TDSYNNEX_RETRY_MAX_ATTEMPTS=3
TDSYNNEX_RETRY_DELAY=1000
TDSYNNEX_LOGGING_ENABLED=true
TDSYNNEX_LOGGING_CHANNEL=stack
TDSYNNEX_LOG_REQUESTS=true
TDSYNNEX_LOG_RESPONSES=false
TDSYNNEX_XML_USE_TEST=true
TDSYNNEX_ALLOW_SUBMIT_PO=false

# PriceAvailability XML credentials / feed settings
SYNNEX_CUSTOMER_NO=
SYNNEX_USERNAME=
SYNNEX_PASSWORD=
SYNNEX_REGION=us
SYNNEX_BATCH_SIZE=50
SYNNEX_MAX_SKUS=0
SYNNEX_PRICE_AVAILABILITY_CACHE_TTL=900
SYNNEX_PRICE_AVAILABILITY_TIMEOUT=8
SYNNEX_PRICE_AVAILABILITY_MAX_RUNTIME=45
SYNNEX_FLAT_FILE_PATH=
SYNNEX_FLAT_FILES_DIR=flat-files
SYNNEX_SKUS=
SYNNEX_SKUS_FILE=

# Icecat product content/image enrichment
ICECAT_ENABLED=true
ICECAT_PERSIST_TO_DB=false
ICECAT_USERNAME=
ICECAT_PASSWORD=
ICECAT_APP_KEY=
ICECAT_ENDPOINT=https://live.icecat.biz/api
ICECAT_LANGUAGE=en
ICECAT_CACHE_TTL=86400
ICECAT_TIMEOUT=6
ICECAT_MAX_LOOKUPS_PER_REQUEST=24

# SerpAPI image enrichment fallback
SERPAPI_IMAGE_ENABLED=true
SERPAPI_API_KEY=
SERPAPI_ENDPOINT=https://serpapi.com/search.json
SERPAPI_ENGINE=google_images
SERPAPI_TBM=isch
SERPAPI_GL=us
SERPAPI_HL=en
SERPAPI_NUM=5
SERPAPI_TIMEOUT=10
SERPAPI_CONNECT_TIMEOUT=3
SERPAPI_MAX_QUERIES=8
SERPAPI_RETRY_ATTEMPTS=3
SERPAPI_RETRY_DELAY_MS=350
SERPAPI_SITE_DOMAINS=cdw.com,cdwg.com,insight.com,connection.com,zones.com,shi.com,provantage.com,bhphotovideo.com,newegg.com,staples.com,officedepot.com,bestbuy.com,amazon.com,walmart.com,apc.com,eaton.com,tripplite.eaton.com,hpe.com,hp.com,dell.com,lenovo.com,cisco.com,arubanetworks.com,lexmark.com,xerox.com,startech.com,viewsonic.com,axis.com,samsung.com,intel.com

# Open GTIN/UPC image fallback (no API key)
GTIN_IMAGE_LOOKUP_ENABLED=true
GTIN_IMAGE_LOOKUP_ENDPOINT=https://www.gtinsearch.org/api/items
GTIN_IMAGE_LOOKUP_TIMEOUT=4
GTIN_IMAGE_LOOKUP_CONNECT_TIMEOUT=2

# Image sync scope (align with currently showing storefront products)
IMAGE_SYNC_CURRENT_SHOWING_ONLY=true
IMAGE_SYNC_HIDE_ZERO_PRICE=true
IMAGE_SYNC_MIN_PRICE=100
IMAGE_SYNC_CATALOG_CLEAN=true
IMAGE_SYNC_SCOPE_CAP=1000
CATALOG_HARDWARE_ONLY=true

# Legacy HTML scraping fallback (recommended off when SerpAPI is used)
IMAGE_SCRAPING_ENABLED=false
