<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent Apache from auto-redirecting directory-style URLs like /resources/
    # before Laravel can serve the canonical landing page at /resources.
    DirectorySlash Off

    # 1. Redirect www host to apex canonical host (fires before anything else).
    RewriteCond %{HTTP_HOST} ^www\.armely\.com$ [NC]
    RewriteRule ^ https://armely.com%{REQUEST_URI} [L,R=301,NE]

    # 2. Strip any /public prefix that leaks into the browser URL.
    #    /public/blog  → /blog   |   /public  → /
    #    Uses THE_REQUEST (original request line) to avoid rewrite loops.
    RewriteCond %{THE_REQUEST} \s/public/(\S+) [NC]
    RewriteRule ^ /%1 [L,R=301,NE]
    RewriteCond %{THE_REQUEST} \s/public[\s?] [NC]
    RewriteRule ^ / [L,R=301,NE]

    # 3a. Serve real static files from store/public/ (store CSS, JS, images …).
    RewriteCond %{REQUEST_URI} ^/store/(.+)$ [NC]
    RewriteCond %{DOCUMENT_ROOT}/store/public/%1 -f
    RewriteRule ^store/(.+)$ store/public/$1 [L]

    # 3b. Serve real static files from public/ (admin CSS, JS, images …).
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^ public%{REQUEST_URI} [L]

    # 4. Route /store/* requests through the store bridge (mirrors what public/.htaccess does).
    RewriteRule ^store(?:/.*)?$ public/store/index.php [L]

    # 5. Everything else (including /) goes straight to the admin/main front controller.
    RewriteRule ^ public/index.php [L]
</IfModule>
