<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Redirect www host to apex canonical host (fires before anything else).
    RewriteCond %{HTTP_HOST} ^www\.armely\.com$ [NC]
    RewriteRule ^ https://armely.com%{REQUEST_URI} [L,R=301,NE]

    # 2. Strip any /public prefix that leaks into the browser URL.
    #    /public/blog  → /blog   |   /public  → /
    #    Uses THE_REQUEST (original request line) to avoid rewrite loops.
    RewriteCond %{THE_REQUEST} \s/public/(\S+) [NC]
    RewriteRule ^ /%1 [L,R=301,NE]
    RewriteCond %{THE_REQUEST} \s/public[\s?] [NC]
    RewriteRule ^ / [L,R=301,NE]

    # 3. Serve real static files that exist inside public/ (CSS, JS, images …).
    #    Never rewrite to the public/ directory itself — that triggers a
    #    mod_dir redirect to /public/ in the browser.
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^ public%{REQUEST_URI} [L]

    # 4. Everything else (including /) goes straight to Laravel's front controller.
    RewriteRule ^ public/index.php [L]
</IfModule>
